---
import { Icon } from 'astro-icon/components'
const { header, title, concertWith, fullDate, day, time, address } = Astro.props
---

<div class='uentry-wrapper flex flex-row pb-4'>
  <div class='bg-[#ff4d6d] w-4'></div>
  <div
    class='flex flex-col grow py-2 px-4 w-full max-w-[510px] bg-[#fff0f3] rounded-tr-md rounded-br-md'
  >
    <div class='text-lg text-[#c9184a] font-oswald font-medium text-center'>
      {header}
    </div>
    <div
      class='text-4xl text-[#800f2f] font-oswald font-bold pb-1 text-center'
    >
      {title}
    </div>
    {concertWith && (
      <div class='text-lg text-[#c9184a] font-oswald font-medium text-center mt-1'>
        IN CONCERT WITH
      </div>
      <div class='text-3xl text-[#800f2f] font-oswald font-bold pb-1 text-center'>
        {concertWith}
      </div>
    )}
    <div class='flex flex-row text-[#c9184a] py-1'>
      <div class='flex justify-center w-fit h-fit'>
        <Icon class='text-3xl' name='calender' />
      </div>
      <div class='pl-2 font-mohave font-medium text-xl w-fit h-fit'>
        {day} - {fullDate} @ {time}
      </div>
    </div>
    <div class='flex flex-row text-[#a4133c]'>
      <div class='flex justify-center w-fit h-fit'>
        <Icon class='text-3xl' name='location' />
      </div>
      <div class='pl-2 font-mohave font-medium text-xl w-fit h-fit'>
        {address}
      </div>
    </div>
  </div>
</div>
