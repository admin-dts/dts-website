<button
  id='back-to-top'
  aria-label='Back to top'
  class='fixed bottom-6 right-6 z-50 bg-violet-600 hover:bg-violet-700 text-white rounded-full w-12 h-12 flex items-center justify-center shadow-lg text-2xl transition-all duration-300 opacity-0 pointer-events-none'
>
  ↑
</button>

<script>
  const btn = document.getElementById('back-to-top') as HTMLButtonElement

  window.addEventListener('scroll', () => {
    if (window.scrollY > 300) {
      btn.style.opacity = '1'
      btn.style.pointerEvents = 'auto'
    } else {
      btn.style.opacity = '0'
      btn.style.pointerEvents = 'none'
    }
  })

  btn.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' })
  })
</script>
