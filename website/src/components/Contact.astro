---
import { Icon } from 'astro-icon/components'
---

<div
  id='contact'
  class='py-16 px-6 flex flex-col items-center h-fit bg-violet-300'
>
  <div class='font-oswald text-center max-[640px]:text-4xl text-6xl text-violet-800 font-bold mb-12'>
    CONTACT US
  </div>

  <img src='contact.png' class='mb-10 max-w-lg max-[640px]:max-w-full w-full' />

  <div class='grid max-[800px]:grid-cols-1 grid-cols-3 gap-6 w-full max-w-5xl'>

    <div class='bg-violet-700 rounded-2xl p-8 flex flex-col items-center text-center'>
      <Icon class='text-5xl text-white mb-3' name='email' />
      <div class='font-oswald font-bold text-white text-2xl mb-4 tracking-wide'>
        EMAIL
      </div>
      <a href='mailto:dreamteamsingers@gmail.com'>
        <div class='font-mohave text-violet-100 text-xl hover:text-white transition-colors break-all'>
          dreamteamsingers@gmail.com
        </div>
      </a>
    </div>

    <div class='bg-violet-700 rounded-2xl p-8 flex flex-col items-center text-center'>
      <Icon class='text-5xl text-white mb-3' name='phone' />
      <div class='font-oswald font-bold text-white text-2xl mb-4 tracking-wide'>
        PHONE
      </div>
      <a href='tel:07933155590'>
        <div class='font-mohave font-bold text-violet-100 text-2xl hover:text-white transition-colors'>
          07933155590
        </div>
      </a>
      <div class='font-mohave text-violet-200 text-xl mt-1'>Carol Warmisham</div>
      <div class='font-mohave text-violet-200 text-lg mt-3'>Preferably between 7pm – 9pm</div>
    </div>

    <div class='bg-violet-700 rounded-2xl p-8 flex flex-col items-center text-center'>
      <Icon class='text-5xl text-white mb-3' name='people' />
      <div class='font-oswald font-bold text-white text-2xl mb-4 tracking-wide'>
        MEETINGS
      </div>
      <div class='font-mohave font-bold text-violet-100 text-2xl'>Every Thursday</div>
      <div class='font-mohave text-violet-100 text-xl'>7:00pm – 9:00pm</div>
      <div class='font-mohave text-violet-200 text-lg mt-3 leading-relaxed'>
        Cleveleys Park Methodist Church,<br />
        West Drive, Cleveleys FY5 2BL<br />
        (Stockdove Way entrance)
      </div>
    </div>

  </div>

</div>
