---
import UEventEntry from './UEventEntry.astro'
---

<div
  id='uevents'
  class='uevents-wrapper py-10 max-[750px]:px-10 px-20 flex flex-col items-center h-fit bg-violet-700'
>
  <div class='font-oswald text-center text-6xl text-violet-100 font-bold w-fit'>
    UPCOMING EVENTS
  </div>
  <div class='flex max-[1380px]:flex-col flex-row items-center pt-6'>
    <img src='choir-vector.svg' />
    <div class='flex flex-col justify-center'>
      <UEventEntry
        header="IN SUPPORT OF"
        title='R.N.L.I.'
        concertWith='Harmony & Health Singers'
        fullDate='23rd May 2026'
        day='Saturday'
        time='6pm'
        address="St Nicolas' Church, Highbury Ave, Fleetwood FY7 7DJ"
      />
      <UEventEntry
        header="IN SUPPORT OF"
        title='The Pantry Foodbank'
        concertWith='Poulton Peoples Choir'
        fullDate='27th June 2026'
        day='Saturday'
        time='2pm'
        address="St Peter's Church, Lord Street, Fleetwood FY7 6DX"
      />
      <UEventEntry
        header="IN SUPPORT OF"
        title="Parkinson's UK"
        fullDate='19th September 2026'
        day='Saturday'
        time='2pm'
        address='Cleveleys Park Methodist Church, West Dr, Cleveleys FY5 2BL (Stockdove Way Entrance)'
      />
    </div>
  </div>
</div>

