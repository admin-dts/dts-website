---
import UEventEntry from './UEventEntry.astro'
---

<div
  id='uevents'
  class='uevents-wrapper py-10 max-[750px]:px-10 px-20 flex flex-col items-center h-fit bg-violet-400'
>
  <div class='font-oswald text-center text-6xl text-violet-800 font-bold w-fit'>
    UPCOMING EVENTS
  </div>
  <div class='flex max-[1380px]:flex-col flex-row items-center pt-6'>
    <img src='choir-vector.svg' />
    <div class='flex flex-col justify-center'>
     <UEventEntry
	header="IN SUPPORT OF"
        fullDate='27 September 2025'
        day='Saturday'
        title="Parkinson's UK"
        time='2pm'
	address='Cleveleys Park Methodist church, West Dr, Cleveleys FY5 2BL'
      />
      <UEventEntry
	header="IN CONCERT WITH"
        fullDate='1 December 2025'
        day='Saturday'
        title='Park Community Academy School Band'
        time='6pm'
        address='St Mary’s RC Church, 34 Kemp Street, Fleetwood FY7 6JX'
      />
      <UEventEntry
	header="IN SUPPORT OF"
        fullDate='13 December 2025'
        day='Saturday'
        title="St Anne's URC & The Trussel Trust Foodbank"
        time='2pm'
	address="St Anne’s-on-Sea United Reform Church, St George's Road, Lytham Saint Annes FY8 2AE"
      />
    </div>
  </div>
</div>

